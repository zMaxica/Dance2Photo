import cv2
import numpy as np
import mss
import keyboard
import pydirectinput
import time
import os
import sys

# ==========================================
# ปรับแต่งความเร็วขั้นสุด
# ==========================================
pydirectinput.FAILSAFE = False
pydirectinput.PAUSE = 0  

MONITOR = {"top": 760, "left": 580, "width": 970, "height": 220}

LOWER_ORANGE = np.array([5, 150, 150])
UPPER_ORANGE = np.array([25, 255, 255])

LOWER_PURPLE = np.array([125, 100, 100])
UPPER_PURPLE = np.array([155, 255, 255])

LOWER_GREEN = np.array([35, 100, 100])
UPPER_GREEN = np.array([85, 255, 255])

HIT_ZONE_START_X = 90  
HIT_ZONE_END_X = 95    

cooldowns = {'a': 0, 's': 0, 'd': 0}
COOLDOWN_TIME = 0.05  

bot_active = False

# ==========================================
# ระบบหา Path รูปภาพ 2 ชั้น (นอก/ใน)
# ==========================================
def get_template_path():
    external_path = os.path.abspath("ui_check.png")
    if os.path.exists(external_path):
        return external_path
        
    try:
        base_path = sys._MEIPASS
    except Exception:
        base_path = os.path.abspath(".")
    return os.path.join(base_path, "ui_check.png")

template_path = get_template_path()

if os.path.exists(template_path):
    ui_template = cv2.imread(template_path, 0)
else:
    ui_template = None

def is_in_stage(frame):
    if ui_template is None:
        return True 
        
    gray_frame = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
    res = cv2.matchTemplate(gray_frame, ui_template, cv2.TM_CCOEFF_NORMED)
    threshold = 0.8 
    loc = np.where(res >= threshold)
    return len(loc[0]) > 0

# ==========================================
# ระบบคีย์ลัด (F9 เปิด/ปิด | F10 ปิดโปรแกรม)
# ==========================================
def toggle_bot():
    global bot_active
    bot_active = not bot_active

def quit_program():
    os._exit(0) # ฆ่าโปรแกรมทันทีแบบถอนรากถอนโคน

keyboard.add_hotkey('f9', toggle_bot)
keyboard.add_hotkey('f10', quit_program) 

sct = mss.mss()

def check_lane(hsv_frame, lower_color, upper_color, original_frame):
    mask = cv2.inRange(hsv_frame, lower_color, upper_color)
    laser_zone = mask[:, HIT_ZONE_START_X:HIT_ZONE_END_X]
    pixel_count = cv2.countNonZero(laser_zone)
    if pixel_count > 15:
        return True
    return False

last_ui_check_time = 0
in_stage = False
UI_CHECK_INTERVAL = 0.5  

while True:
    current_time = time.time()
    
    screenshot = sct.grab(MONITOR)
    frame = np.array(screenshot)
    frame = cv2.cvtColor(frame, cv2.COLOR_BGRA2BGR)
    hsv = cv2.cvtColor(frame, cv2.COLOR_BGR2HSV)

    # เช็คด่านทุกๆ 0.5 วินาที
    if current_time - last_ui_check_time > UI_CHECK_INTERVAL:
        in_stage = is_in_stage(frame)
        last_ui_check_time = current_time 

    # วาดเส้นเลเซอร์สีเหลือง
    cv2.rectangle(frame, (HIT_ZONE_START_X, 0), (HIT_ZONE_END_X, MONITOR["height"]), (0, 255, 255), 1)

    # เช็คสีตัวโน้ต
    need_a = check_lane(hsv, LOWER_ORANGE, UPPER_ORANGE, frame)
    need_s = check_lane(hsv, LOWER_PURPLE, UPPER_PURPLE, frame)
    need_d = check_lane(hsv, LOWER_GREEN, UPPER_GREEN, frame)

    keys_to_press = []
    if need_a and (current_time - cooldowns['a'] > COOLDOWN_TIME):
        keys_to_press.append('a')
    if need_s and (current_time - cooldowns['s'] > COOLDOWN_TIME):
        keys_to_press.append('s')
    if need_d and (current_time - cooldowns['d'] > COOLDOWN_TIME):
        keys_to_press.append('d')

    if bot_active and in_stage and keys_to_press:
        for key in keys_to_press:
            pydirectinput.keyDown(key)
        for key in keys_to_press:
            pydirectinput.keyUp(key)
            cooldowns[key] = current_time 

    # แสดงข้อความ UI
    status_text = "STATUS: ON" if bot_active else "STATUS: OFF (F9 Toggle | F10 Exit)"
    stage_text = " [Dance Mission]" if in_stage else " [WAITING...]"
    text_color = (0, 255, 0) if bot_active else (0, 0, 255)
    
    cv2.putText(frame, status_text + stage_text, (10, 30), cv2.FONT_HERSHEY_SIMPLEX, 0.8, text_color, 2, cv2.LINE_AA)
    cv2.putText(frame, "Require: 1600x900", (10, 55), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255, 255, 255), 1, cv2.LINE_AA)
    
    cv2.imshow("NOTE DETECTOR", frame)
    
    # ==========================================
    # ระบบปิดโปรแกรมแบบ 100%
    # ==========================================
    # 1. เช็คว่าหน้าต่างถูกกดปุ่มกากบาท (X) ปิดไปหรือยัง
    if cv2.getWindowProperty("NOTE DETECTOR", cv2.WND_PROP_VISIBLE) < 1:
        os._exit(0)
        
    # 2. หรือถ้ากดปุ่ม 'q' ที่หน้าต่าง ก็ให้ปิดเช่นกัน
    if cv2.waitKey(1) & 0xFF == ord("q"):
        os._exit(0)
