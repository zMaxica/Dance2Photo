import cv2
import numpy as np
import mss
import pydirectinput
import time
import os
import sys
import ctypes

try:
    ctypes.windll.shell32.SetCurrentProcessExplicitAppUserModelID(
        "NAJANARAK55555.app.1"
    )
except Exception:
    pass

# ==========================================
# NAJANARAK55555 - OPTIMIZED EDITION (FIXED)
# Core i3 / RAM 8GB / Integrated GPU
# แก้: เลิกใช้ keyboard hook -> ใช้ GetAsyncKeyState polling
#      เพิ่ม sleep ท้ายลูป, timer 1ms, กันจับภาพ error
# ==========================================

pydirectinput.FAILSAFE = False
pydirectinput.PAUSE = 0

user32 = ctypes.windll.user32
winmm = ctypes.windll.winmm

# ==========================================
# ตั้งค่าหลัก
# ==========================================

MONITOR = {
    "top": 760,
    "left": 580,
    "width": 970,
    "height": 220
}

# เปิด/ปิดหน้าต่าง Preview
SHOW_PREVIEW = True

# อัปเดต Preview สูงสุดประมาณ 20 FPS
PREVIEW_INTERVAL = 0.05

# ==========================================
# ตั้งค่าสี HSV
# ==========================================

LOWER_ORANGE = np.array([5, 150, 150])
UPPER_ORANGE = np.array([25, 255, 255])

LOWER_PURPLE = np.array([125, 100, 100])
UPPER_PURPLE = np.array([155, 255, 255])

LOWER_GREEN = np.array([35, 100, 100])
UPPER_GREEN = np.array([85, 255, 255])

# ==========================================
# ตำแหน่งตรวจจับ
# ==========================================

HIT_ZONE_START_X = 90
HIT_ZONE_END_X = 95

PIXEL_THRESHOLD = 15

# ==========================================
# Cooldown
# ==========================================

cooldowns = {
    'a': 0,
    's': 0,
    'd': 0
}

COOLDOWN_TIME = 0.05

# ==========================================
# สถานะโปรแกรม
# ==========================================

bot_active = False
w_hold_active = False
running = True

# ==========================================
# ระบบหา Path รูปภาพ
# ==========================================

def get_template_path():

    external_path = os.path.abspath("ui_check.png")

    if os.path.exists(external_path):
        return external_path

    try:
        base_path = sys._MEIPASS
    except Exception:
        base_path = os.path.abspath(".")

    return os.path.join(base_path, "ui_check.png")


template_path = get_template_path()

if os.path.exists(template_path):
    ui_template = cv2.imread(template_path, 0)
else:
    ui_template = None

# ==========================================
# ตรวจสอบสถานะด่าน
# ==========================================

def is_in_stage(frame):

    if ui_template is None:
        return True

    gray_frame = cv2.cvtColor(
        frame,
        cv2.COLOR_BGR2GRAY
    )

    if (
        ui_template.shape[0] > gray_frame.shape[0]
        or ui_template.shape[1] > gray_frame.shape[1]
    ):
        return False

    res = cv2.matchTemplate(
        gray_frame,
        ui_template,
        cv2.TM_CCOEFF_NORMED
    )

    return np.any(res >= 0.8)


# ==========================================
# Hotkeys (ฟังก์ชันการทำงาน)
# ==========================================

def toggle_bot():

    global bot_active

    bot_active = not bot_active

    print("BOT:", "ON" if bot_active else "OFF")


def toggle_w_hold():

    global w_hold_active

    w_hold_active = not w_hold_active

    if w_hold_active:
        pydirectinput.keyDown('w')
        print("W: HOLDING")
    else:
        pydirectinput.keyUp('w')
        print("W: RELEASED")


def quit_program():

    global running

    running = False


# ==========================================
# Hotkeys แบบ Polling (ไม่ใช้ hook จึงไม่โดน Windows ถอด)
# ==========================================

HOTKEYS = {
    0x77: toggle_w_hold,   # F8
    0x78: toggle_bot,      # F9
    0x79: quit_program,    # F10
}

_prev_state = {vk: False for vk in HOTKEYS}


def poll_hotkeys():

    for vk, action in HOTKEYS.items():

        down = bool(user32.GetAsyncKeyState(vk) & 0x8000)

        # จับเฉพาะตอนเพิ่งกดลง
        if down and not _prev_state[vk]:
            action()

        _prev_state[vk] = down


# ==========================================
# MSS Capture
# ==========================================

sct = mss.mss()

# ==========================================
# ตรวจจับสีเฉพาะบริเวณเลเซอร์
# ==========================================

def check_lane(hsv_roi, lower_color, upper_color):

    mask = cv2.inRange(
        hsv_roi,
        lower_color,
        upper_color
    )

    pixel_count = cv2.countNonZero(mask)

    return pixel_count > PIXEL_THRESHOLD


# ==========================================
# ตัวแปรระบบ
# ==========================================

last_ui_check_time = 0
in_stage = False

UI_CHECK_INTERVAL = 0.5

fps = 0
fps_counter = 0
fps_start = time.perf_counter()

capture_ms = 0
detect_ms = 0
input_ms = 0

last_preview_time = 0

# ==========================================
# สร้างหน้าต่าง Preview
# ==========================================

if SHOW_PREVIEW:

    cv2.namedWindow(
        "NAJANARAK55555",
        cv2.WINDOW_NORMAL
    )

# ตั้งความละเอียด timer ของ Windows เป็น 1ms
winmm.timeBeginPeriod(1)

# ==========================================
# MAIN LOOP
# ==========================================

try:

    while running:

        # เช็คปุ่ม F8/F9/F10 ทุกรอบ
        poll_hotkeys()

        current_time = time.time()

        # ----------------------------------
        # 1. CAPTURE (กัน error ไม่ให้ลูปค้าง)
        # ----------------------------------

        capture_start = time.perf_counter()

        try:
            screenshot = sct.grab(MONITOR)

            frame = cv2.cvtColor(
                np.array(screenshot),
                cv2.COLOR_BGRA2BGR
            )

        except Exception as e:

            print("CAPTURE ERROR:", e)

            # สร้าง mss ใหม่เผื่อ handle เสีย
            try:
                sct.close()
            except Exception:
                pass

            try:
                sct = mss.mss()
            except Exception:
                pass

            time.sleep(0.1)
            continue

        capture_ms = (
            time.perf_counter() - capture_start
        ) * 1000

        # ----------------------------------
        # 2. ตรวจสอบสถานะด่าน
        # ----------------------------------

        if current_time - last_ui_check_time >= UI_CHECK_INTERVAL:

            in_stage = is_in_stage(frame)

            last_ui_check_time = current_time

        # ----------------------------------
        # 3. DETECTION
        # ประมวลผลเฉพาะพื้นที่เลเซอร์
        # ----------------------------------

        detect_start = time.perf_counter()

        roi = frame[
            :,
            HIT_ZONE_START_X:HIT_ZONE_END_X
        ]

        hsv_roi = cv2.cvtColor(
            roi,
            cv2.COLOR_BGR2HSV
        )

        need_a = check_lane(
            hsv_roi,
            LOWER_ORANGE,
            UPPER_ORANGE
        )

        need_s = check_lane(
            hsv_roi,
            LOWER_PURPLE,
            UPPER_PURPLE
        )

        need_d = check_lane(
            hsv_roi,
            LOWER_GREEN,
            UPPER_GREEN
        )

        detect_ms = (
            time.perf_counter() - detect_start
        ) * 1000

        # ----------------------------------
        # 4. INPUT
        # ----------------------------------

        keys_to_press = []

        if need_a and current_time - cooldowns['a'] > COOLDOWN_TIME:
            keys_to_press.append('a')

        if need_s and current_time - cooldowns['s'] > COOLDOWN_TIME:
            keys_to_press.append('s')

        if need_d and current_time - cooldowns['d'] > COOLDOWN_TIME:
            keys_to_press.append('d')

        input_start = time.perf_counter()

        if bot_active and in_stage and keys_to_press:

            for key in keys_to_press:
                pydirectinput.keyDown(key)

            for key in keys_to_press:

                pydirectinput.keyUp(key)

                cooldowns[key] = current_time

        input_ms = (
            time.perf_counter() - input_start
        ) * 1000

        # ----------------------------------
        # 5. FPS COUNTER
        # ----------------------------------

        fps_counter += 1

        fps_elapsed = time.perf_counter() - fps_start

        if fps_elapsed >= 1.0:

            fps = fps_counter / fps_elapsed

            fps_counter = 0

            fps_start = time.perf_counter()

        # ----------------------------------
        # 6. PREVIEW
        # ----------------------------------

        if SHOW_PREVIEW:

            preview_time = time.perf_counter()

            if preview_time - last_preview_time >= PREVIEW_INTERVAL:

                display_frame = frame.copy()

                # เส้นเลเซอร์
                cv2.rectangle(
                    display_frame,
                    (HIT_ZONE_START_X, 0),
                    (HIT_ZONE_END_X, MONITOR["height"]),
                    (0, 255, 255),
                    1
                )

                # สถานะบอท
                status_text = (
                    "STATUS: ON"
                    if bot_active
                    else "STATUS: OFF"
                )

                stage_text = (
                    " [Dance Mission]"
                    if in_stage
                    else " [WAITING...]"
                )

                text_color = (
                    (0, 255, 0)
                    if bot_active
                    else (0, 0, 255)
                )

                w_status = (
                    "HOLDING W"
                    if w_hold_active
                    else "W OFF (F8)"
                )

                w_color = (
                    (0, 255, 255)
                    if w_hold_active
                    else (200, 200, 200)
                )

                cv2.putText(
                    display_frame,
                    status_text + stage_text,
                    (10, 30),
                    cv2.FONT_HERSHEY_SIMPLEX,
                    0.7,
                    text_color,
                    2,
                    cv2.LINE_AA
                )

                cv2.putText(
                    display_frame,
                    f"FPS: {fps:.1f}",
                    (10, 55),
                    cv2.FONT_HERSHEY_SIMPLEX,
                    0.55,
                    (255, 255, 255),
                    1
                )

                cv2.putText(
                    display_frame,
                    f"Capture: {capture_ms:.2f} ms",
                    (10, 80),
                    cv2.FONT_HERSHEY_SIMPLEX,
                    0.5,
                    (255, 255, 255),
                    1
                )

                cv2.putText(
                    display_frame,
                    f"Detect: {detect_ms:.2f} ms",
                    (10, 102),
                    cv2.FONT_HERSHEY_SIMPLEX,
                    0.5,
                    (255, 255, 255),
                    1
                )

                cv2.putText(
                    display_frame,
                    f"Input: {input_ms:.2f} ms",
                    (10, 124),
                    cv2.FONT_HERSHEY_SIMPLEX,
                    0.5,
                    (255, 255, 255),
                    1
                )

                cv2.putText(
                    display_frame,
                    w_status,
                    (10, 150),
                    cv2.FONT_HERSHEY_SIMPLEX,
                    0.6,
                    w_color,
                    1,
                    cv2.LINE_AA
                )

                cv2.imshow(
                    "NAJANARAK55555",
                    display_frame
                )

                last_preview_time = preview_time

            # ตรวจสอบการปิดหน้าต่าง
            key = cv2.waitKey(1) & 0xFF

            if key == ord('q'):
                quit_program()

            try:

                if cv2.getWindowProperty(
                    "NAJANARAK55555",
                    cv2.WND_PROP_VISIBLE
                ) < 1:

                    quit_program()

            except cv2.error:

                quit_program()

        # ----------------------------------
        # 7. ให้ CPU หายใจ (กัน hotkey/ระบบอื่นอดอยาก)
        # ----------------------------------

        time.sleep(0.001)

# ==========================================
# CLEANUP
# ==========================================

finally:

    # ปล่อยทุกปุ่มก่อนออก
    for key in ['w', 'a', 's', 'd']:

        try:
            pydirectinput.keyUp(key)
        except Exception:
            pass

    w_hold_active = False

    try:
        cv2.destroyAllWindows()
    except Exception:
        pass

    try:
        sct.close()
    except Exception:
        pass

    try:
        winmm.timeEndPeriod(1)
    except Exception:
        pass

    print("NAJANARAK55555 EXITED")
