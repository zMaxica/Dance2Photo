# Source Code หากต้องการป้องกันการแก้โค้ด/ข้ามสิทธิ์จริงจัง
# ควรใช้ Server ตรวจสอบ License เพิ่มเติม

ALLOWED_MACHINE_IDS = {
    # ใส่ MachineGuid จาก Windows Registry โดยตรง (ไม่ต้อง Hash)
    "5aed1745d-e8c9-3a15-be92a",  # เครื่องที่บ้าน
    "5e753550-5356-4d27-87b0-ef862707388d",  # เครื่องที่ทำงาน
}


def get_machine_id():
    """อ่าน MachineGuid จาก Windows Registry โดยตรง"""
    try:
        registry_key = winreg.OpenKey(
            winreg.HKEY_LOCAL_MACHINE,
            r"SOFTWARE\Microsoft\Cryptography"
        )
        try:
            machine_guid, _ = winreg.QueryValueEx(registry_key, "MachineGuid")
        finally:
            winreg.CloseKey(registry_key)
        return str(machine_guid).strip().lower()
    except Exception as exc:
        raise RuntimeError(
            "ไม่สามารถอ่าน Windows MachineGuid ได้: " + str(exc)
        )


def verify_machine():
    try:
        machine_id = get_machine_id()
    except Exception:
        # หากอ่าน Machine ID ไม่ได้ ให้ปิดแบบเงียบเช่นกัน
        os._exit(0)

    if machine_id not in ALLOWED_MACHINE_IDS:
        # Silent Exit: เครื่องที่ไม่ได้ลงทะเบียนจะปิดตัวเองทันที
        # ไม่แสดงข้อความ, Machine ID หรือหน้าต่างแจ้งเตือน
        os._exit(0)

    # เครื่องที่ได้รับอนุญาตจึงทำงานต่อ
    print("[LICENSE] Authorized machine")
    print("[HOTKEY] F8=Preview ON/OFF | F9=BOT ON/OFF | F10=Exit")


# ตรวจสอบสิทธิ์ก่อนเริ่มทำงานหลัก
verify_machine()

# ==========================================
# ตั้งค่าหลัก
# ==========================================

MONITOR = {
    "top": 760,
    "left": 580,
    "width": 970,
    "height": 220
}

# เปิด/ปิดหน้าต่าง Preview
SHOW_PREVIEW = True

# อัปเดต Preview สูงสุดประมาณ 20 FPS
PREVIEW_INTERVAL = 0.05

# ==========================================
# ตั้งค่าสี HSV
# ==========================================

LOWER_ORANGE = np.array([5, 150, 150])
UPPER_ORANGE = np.array([25, 255, 255])

LOWER_PURPLE = np.array([125, 100, 100])
UPPER_PURPLE = np.array([155, 255, 255])

LOWER_GREEN = np.array([35, 100, 100])
UPPER_GREEN = np.array([85, 255, 255])

# ==========================================
# ตำแหน่งตรวจจับ
# ==========================================

HIT_ZONE_START_X = 90
HIT_ZONE_END_X = 95

PIXEL_THRESHOLD = 15

# ==========================================
# Cooldown
# ==========================================

cooldowns = {
    'a': 0,
    's': 0,
    'd': 0
}

COOLDOWN_TIME = 0.05

# ==========================================
# สถานะโปรแกรม
# ==========================================

bot_active = False
running = True

# ==========================================
# ระบบหา Path รูปภาพ
# ==========================================

def get_template_path():

    external_path = os.path.abspath("ui_check.png")

    if os.path.exists(external_path):
        return external_path

    try:
        base_path = sys._MEIPASS
    except Exception:
        base_path = os.path.abspath(".")

    return os.path.join(base_path, "ui_check.png")


template_path = get_template_path()

if os.path.exists(template_path):
    ui_template = cv2.imread(template_path, 0)
else:
    ui_template = None

# ==========================================
# ตรวจสอบสถานะด่าน
# ==========================================

def is_in_stage(frame):

    if ui_template is None:
        return True

    gray_frame = cv2.cvtColor(
        frame,
        cv2.COLOR_BGR2GRAY
    )

    if (
        ui_template.shape[0] > gray_frame.shape[0]
        or ui_template.shape[1] > gray_frame.shape[1]
    ):
        return False

    res = cv2.matchTemplate(
        gray_frame,
        ui_template,
        cv2.TM_CCOEFF_NORMED
    )

    return np.any(res >= 0.8)


# ==========================================
# Hotkeys (ฟังก์ชันการทำงาน)
# ==========================================

def toggle_bot():

    global bot_active

    bot_active = not bot_active

    print("BOT:", "ON" if bot_active else "OFF")


def toggle_preview():

    global SHOW_PREVIEW

    SHOW_PREVIEW = not SHOW_PREVIEW

    if SHOW_PREVIEW:
        try:
            cv2.namedWindow("NAJANARAK55555", cv2.WINDOW_NORMAL)
            print("PREVIEW: ON")
        except cv2.error as exc:
            SHOW_PREVIEW = False
            print("PREVIEW ERROR:", exc)
    else:
        try:
            cv2.destroyWindow("NAJANARAK55555")
        except cv2.error:
            pass
        print("PREVIEW: OFF")


def quit_program():

    global running

    running = False


# ==========================================
# Hotkeys แบบ Polling (ไม่ใช้ hook จึงไม่โดน Windows ถอด)
# ==========================================

HOTKEYS = {
    0x77: toggle_preview,  # F8 - เปิด/ปิด Preview
    0x78: toggle_bot,      # F9 - เปิด/ปิด BOT
    0x79: quit_program,    # F10 - ออกจากโปรแกรม
}

_prev_state = {vk: False for vk in HOTKEYS}


def poll_hotkeys():

    for vk, action in HOTKEYS.items():

        down = bool(user32.GetAsyncKeyState(vk) & 0x8000)

        # จับเฉพาะตอนเพิ่งกดลง
        if down and not _prev_state[vk]:
            action()

        _prev_state[vk] = down


# ==========================================
# MSS Capture
# ==========================================

sct = mss.mss()

# ==========================================
# ตรวจจับสีเฉพาะบริเวณเลเซอร์
# ==========================================

def check_lane(hsv_roi, lower_color, upper_color):

    mask = cv2.inRange(
        hsv_roi,
        lower_color,
        upper_color
    )

    pixel_count = cv2.countNonZero(mask)

    return pixel_count > PIXEL_THRESHOLD


# ==========================================
# ตัวแปรระบบ
# ==========================================

last_ui_check_time = 0
in_stage = False

UI_CHECK_INTERVAL = 0.5

fps = 0
fps_counter = 0
fps_start = time.perf_counter()

capture_ms = 0
detect_ms = 0
input_ms = 0

last_preview_time = 0

# ==========================================
# สร้างหน้าต่าง Preview
# ==========================================

if SHOW_PREVIEW:
    cv2.namedWindow("NAJANARAK55555", cv2.WINDOW_NORMAL)

# ตั้งความละเอียด timer ของ Windows เป็น 1ms
winmm.timeBeginPeriod(1)

# ==========================================
# MAIN LOOP
# ==========================================

try:

    while running:

        # เช็คปุ่ม F8/F9/F10 ทุกรอบ
        poll_hotkeys()

        current_time = time.time()

        # ----------------------------------
        # 1. CAPTURE (กัน error ไม่ให้ลูปค้าง)
        # ----------------------------------

        capture_start = time.perf_counter()

        try:
            screenshot = sct.grab(MONITOR)

            frame = cv2.cvtColor(
                np.array(screenshot),
                cv2.COLOR_BGRA2BGR
            )

        except Exception as e:

            print("CAPTURE ERROR:", e)

            # สร้าง mss ใหม่เผื่อ handle เสีย
            try:
                sct.close()
            except Exception:
                pass

            try:
                sct = mss.mss()
            except Exception:
                pass

            time.sleep(0.1)
            continue

        capture_ms = (
            time.perf_counter() - capture_start
        ) * 1000

        # ----------------------------------
        # 2. ตรวจสอบสถานะด่าน
        # ----------------------------------

        if current_time - last_ui_check_time >= UI_CHECK_INTERVAL:

            in_stage = is_in_stage(frame)

            last_ui_check_time = current_time

        # ----------------------------------
        # 3. DETECTION
        # ประมวลผลเฉพาะพื้นที่เลเซอร์
        # ----------------------------------

        detect_start = time.perf_counter()

        roi = frame[
            :,
            HIT_ZONE_START_X:HIT_ZONE_END_X
        ]

        hsv_roi = cv2.cvtColor(
            roi,
            cv2.COLOR_BGR2HSV
        )

        need_a = check_lane(
            hsv_roi,
            LOWER_ORANGE,
            UPPER_ORANGE
        )

        need_s = check_lane(
            hsv_roi,
            LOWER_PURPLE,
            UPPER_PURPLE
        )

        need_d = check_lane(
            hsv_roi,
            LOWER_GREEN,
            UPPER_GREEN
        )

        detect_ms = (
            time.perf_counter() - detect_start
        ) * 1000

        # ----------------------------------
        # 4. INPUT
        # ----------------------------------

        keys_to_press = []

        if need_a and current_time - cooldowns['a'] > COOLDOWN_TIME:
            keys_to_press.append('a')

        if need_s and current_time - cooldowns['s'] > COOLDOWN_TIME:
            keys_to_press.append('s')

        if need_d and current_time - cooldowns['d'] > COOLDOWN_TIME:
            keys_to_press.append('d')

        input_start = time.perf_counter()

        if bot_active and in_stage and keys_to_press:

            for key in keys_to_press:
                pydirectinput.keyDown(key)

            for key in keys_to_press:

                pydirectinput.keyUp(key)

                cooldowns[key] = current_time

        input_ms = (
            time.perf_counter() - input_start
        ) * 1000

        # ----------------------------------
        # 5. FPS COUNTER
        # ----------------------------------

        fps_counter += 1

        fps_elapsed = time.perf_counter() - fps_start

        if fps_elapsed >= 1.0:

            fps = fps_counter / fps_elapsed

            fps_counter = 0

            fps_start = time.perf_counter()

        # ----------------------------------
        # 6. PREVIEW
        # ----------------------------------

        if SHOW_PREVIEW:

            preview_time = time.perf_counter()

            if preview_time - last_preview_time >= PREVIEW_INTERVAL:

                display_frame = frame.copy()

                # เส้นเลเซอร์
                cv2.rectangle(
                    display_frame,
                    (HIT_ZONE_START_X, 0),
                    (HIT_ZONE_END_X, MONITOR["height"]),
                    (0, 255, 255),
                    1
                )

                # สถานะบอท
                status_text = (
                    "STATUS: ON"
                    if bot_active
                    else "STATUS: OFF"
                )

                stage_text = (
                    " [Dance Mission]"
                    if in_stage
                    else " [WAITING...]"
                )

                text_color = (
                    (0, 255, 0)
                    if bot_active
                    else (0, 0, 255)
                )

                cv2.putText(
                    display_frame,
                    status_text + stage_text,
                    (10, 30),
                    cv2.FONT_HERSHEY_SIMPLEX,
                    0.7,
                    text_color,
                    2,
                    cv2.LINE_AA
                )

                cv2.putText(
                    display_frame,
                    f"FPS: {fps:.1f}",
                    (10, 55),
                    cv2.FONT_HERSHEY_SIMPLEX,
                    0.55,
                    (255, 255, 255),
                    1
                )

                cv2.putText(
                    display_frame,
                    f"Capture: {capture_ms:.2f} ms",
                    (10, 80),
                    cv2.FONT_HERSHEY_SIMPLEX,
                    0.5,
                    (255, 255, 255),
                    1
                )

                cv2.putText(
                    display_frame,
                    f"Detect: {detect_ms:.2f} ms",
                    (10, 102),
                    cv2.FONT_HERSHEY_SIMPLEX,
                    0.5,
                    (255, 255, 255),
                    1
                )

                cv2.putText(
                    display_frame,
                    f"Input: {input_ms:.2f} ms",
                    (10, 124),
                    cv2.FONT_HERSHEY_SIMPLEX,
                    0.5,
                    (255, 255, 255),
                    1
                )

                cv2.imshow(
                    "NAJANARAK55555",
                    display_frame
                )

                last_preview_time = preview_time

            # ตรวจสอบการปิดหน้าต่าง
            key = cv2.waitKey(1) & 0xFF

            if key == ord('q'):
                quit_program()

            try:

                if cv2.getWindowProperty(
                    "NAJANARAK55555",
                    cv2.WND_PROP_VISIBLE
                ) < 1:

                    quit_program()

            except cv2.error:

                quit_program()

        # ----------------------------------
        # 7. ให้ CPU หายใจ (กัน hotkey/ระบบอื่นอดอยาก)
        # ----------------------------------

        time.sleep(0.001)

# ==========================================
# CLEANUP
# ==========================================

finally:

    # ปล่อยทุกปุ่มก่อนออก
    for key in ['a', 's', 'd']:

        try:
            pydirectinput.keyUp(key)
        except Exception:
            pass

    
    try:
        cv2.destroyAllWindows()
    except Exception:
        pass

    try:
        sct.close()
    except Exception:
        pass

    try:
        winmm.timeEndPeriod(1)
    except Exception:
        pass

    print("NAJANARAK55555 EXITED")
